# Kopie zapasowe i blokada zapisu panelu admina - powstają na serwerze,
# nie trafiają do repozytorium (zostaje tylko .htaccess blokujący dostęp).
study_roadmap_admin/data/backups/*
!study_roadmap_admin/data/backups/.htaccess

# Pliki tymczasowe zapisu z panelu
study_roadmap_admin/data/.*.tmp

